{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diskmap",
  "version": "0.1.0",
  "identifier": "dev.diskmap.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "diskmap",
        "width": 1360,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#1B1C1F",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-color-profile=srgb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "paul-charp",
    "copyright": "Copyright (c) 2026 paul-charp",
    "homepage": "https://github.com/paul-charp/Disk-Map",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Utility",
    "shortDescription": "Disk-usage treemap",
    "longDescription": "Windows disk-usage treemap with live updates and an NTFS MFT scanner.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}