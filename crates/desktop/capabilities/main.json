    "allow-stop-scan",
    "allow-close-tab",
    "allow-layout",
    "allow-select",
    "allow-zoom",
    "allow-nav-back",
    "allow-nav-forward",
    "allow-nav-up",
    "allow-nav-home",
    "allow-tag",
    "allow-clear-tags",
    "allow-set-filter",
    "allow-set-detail",
    "allow-set-toggle",
    "allow-set-file-colors",
    "allow-details",
    "allow-stats",
    "allow-find-node",
    "allow-open-node",
    "allow-reveal-node",
    "allow-terminal-node",
    "allow-properties-node",
    "allow-recycle-node",
    "allow-start-info",
    "allow-set-pin",
    "allow-browse",
    "allow-export",
    "allow-elevate",
